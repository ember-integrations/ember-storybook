{
  "name": "typedoc-plugin-ember",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "TypeDoc plugin for Ember GTS/GJS files",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:js": "echo 'ok'",
    "lint:types": "echo 'ok'",
    "test": "vitest run"
  },
  "dependencies": {
    "content-tag": "^4.0.0"
  },
  "peerDependencies": {
    "typedoc": ">=0.28.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsdown": "^0.22.0",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
