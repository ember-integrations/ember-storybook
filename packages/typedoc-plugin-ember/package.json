{
  "name": "typedoc-plugin-ember",
  "version": "0.0.3",
  "license": "MIT",
  "description": "TypeDoc plugin for Ember",
  "type": "module",
  "repository": "https://github.com/ember-integrations/ember-storybook",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "content-tag": "catalog:build"
  },
  "peerDependencies": {
    "typedoc": ">=0.28.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsdown": "catalog:build",
    "typedoc": "catalog:lib",
    "typescript": "catalog:build",
    "vitest": "catalog:test"
  }
}
