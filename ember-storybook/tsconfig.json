{
  "compilerOptions": {
    "rootDir": "./src",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "declarations",
    "types": [
      "ember-source/types"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}