{
  "extends": "@ember/app-tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types"
    ],
    "paths": {
      "#app/*": ["./app/*"]
    }
  },
  "include": [
    "app/**/*",
    ".storybook/**/*"
  ]
}
