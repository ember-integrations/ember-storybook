  "type": "module",
  "imports": {
    "#app/*": "./app/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "_build": "vite build",
    "dev": "vite",
    "start": "vite",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "sb": "storybook dev -p 6006 --loglevel trace --debug",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "dependencies": {
    "@embroider/macros": "catalog:frontend",
    "@embroider/router": "catalog:frontend",
    "@glimmer/component": "2.1.1",
